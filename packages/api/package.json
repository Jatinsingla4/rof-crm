{
  "name": "@rof-crm/api",
  "version": "1.0.0",
  "description": "ROF CRM - Backend API (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "db:migrate": "node dist/db/migrations.js",
    "seed:demo": "tsx src/scripts/seed-demo-data.ts",
    "seed:fresh": "tsx src/scripts/seed-demo-data.ts FRESH_PROJECT",
    "seed:active": "tsx src/scripts/seed-demo-data.ts ACTIVE_PROJECT",
    "seed:mature": "tsx src/scripts/seed-demo-data.ts MATURE_PROJECT",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.24.0",
    "@rof-crm/types": "workspace:*",
    "@types/helmet": "^4.0.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.11.5",
    "csv-parse": "^5.5.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.4.1",
    "handlebars": "^4.7.7",
    "helmet": "^8.1.0",
    "jsonwebtoken": "9.0.3",
    "node-cron": "^3.0.2",
    "nodemailer": "^6.9.7",
    "pg": "^8.11.3",
    "puppeteer": "^21.6.1",
    "redis": "^4.6.12",
    "twilio": "^4.10.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.10.5",
    "@types/node-cron": "^3.0.9",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.11.2",
    "eslint": "^8.55.0",
    "prettier": "^3.1.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}

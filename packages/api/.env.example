# ============================================================
# ROF CRM — Environment Configuration Template
# ============================================================
# DEPLOYMENT INSTRUCTIONS FOR ROF IT TEAM:
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. Fill in all values marked with:
#    CHANGE_THIS, YOUR_PASSWORD, YOUR_TOKEN, etc.
#
# 3. NEVER commit .env to git
#    .env is protected in .gitignore
#
# 4. Keep .env secure (chmod 600 on Linux/Mac)
#    This file contains production secrets
#
# 5. For each environment (dev/staging/prod),
#    use a separate .env file with different secrets
#
# CRITICAL: Change all default values in production!
# ============================================================

# ============================================================
# ENVIRONMENT & SERVER
# ============================================================
# Deployment environment
# Options: development, staging, production
# IMPORTANT: Set to 'production' for production deployment
NODE_ENV=development

# Dev-only shortcuts (mock-jwt-token, login for users without a password). Never set in production.
# ALLOW_DEV_AUTH=true

# Server port (frontend will need to know this)
PORT=3001

# Base URL for API (used in emails, notifications)
# Set this to your production domain for notifications
API_BASE_URL=http://localhost:3001

# CORS allowed origins (comma-separated)
# Add your production domain and any frontend domains
# Example: https://crm.rof.co.in,https://admin.rof.co.in
ALLOWED_ORIGINS=http://localhost:3001

# ============================================================
# DATABASE (PostgreSQL 15+)
# ============================================================
# Host where PostgreSQL server is running
DB_HOST=localhost

# PostgreSQL port (default 5432)
DB_PORT=5432

# Database name
# IMPORTANT: Create this database before running migrations
# See: docs/SETUP.md for database creation steps
DB_NAME=rof_crm

# PostgreSQL user with full permissions on DB_NAME
# IMPORTANT: Create this user with:
#   CREATE USER postgres WITH PASSWORD 'your_password';
#   ALTER USER postgres SUPERUSER;
#   (or use RDS managed user for AWS)
DB_USER=postgres

# PostgreSQL password for DB_USER
# IMPORTANT: Use a strong password in production!
# Generate with: openssl rand -base64 32
# NEVER use default 'postgres' password in production
DB_PASSWORD=CHANGE_THIS_TO_YOUR_SECURE_PASSWORD

# ============================================================
# AUTHENTICATION (JWT)
# ============================================================
# Secret key for signing JWT tokens
# This is critical for security - change immediately!
# Generate with: openssl rand -base64 64
#
# WARNING: Changing this will invalidate all issued tokens.
# All users will need to log in again.
# Do this only during maintenance windows.
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# JWT token expiry (short-lived access tokens)
# Format: Value + Unit (e.g., 15m, 1h, 1d)
# Recommended: 15m-1h for access tokens
JWT_EXPIRY=15m

# JWT refresh token expiry (long-lived, used to get new access tokens)
# Format: Value + Unit (e.g., 7d, 30d)
# Recommended: 7-30 days
JWT_REFRESH_EXPIRY=7d

# ============================================================
# SECURITY & ENCRYPTION
# ============================================================
# Secret for hashing sensitive PII (Aadhaar, PAN)
# Used with HMAC-SHA256 for irreversible hashing
# This is critical for privacy compliance!
# Generate with: openssl rand -base64 32
#
# WARNING: Changing this will invalidate all existing hashed PII.
# Consumers cannot be looked up by Aadhaar/PAN after change.
# This should be stable for production.
#
# REGULATORY NOTE: Aadhaar hashing required under Aadhaar Act 2016
# and Digital Personal Data Protection Act 2023
HASH_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_FOR_PII_HASHING

# ============================================================
# REDIS (for Job Queue / Message Broker)
# ============================================================
# IMPORTANT: Redis is REQUIRED for production operation!
# Without Redis, the following features will NOT work:
#   - Demand letter scheduling (15 days, 7 days, 3 days before due date)
#   - Email delivery queue
#   - SMS notification queue
#   - Asynchronous document generation
#   - Batch imports
#
# For production, use:
#   - AWS ElastiCache (recommended for managed service)
#   - Self-hosted Redis with replication and persistence
#   - DO NOT use development mode in production
#
# Format: redis://[:password@]host[:port]/[db]
# Examples:
#   redis://localhost:6379
#   redis://mypassword@redis.c1234.ng.0001.use1.cache.amazonaws.com:6379

# Redis connection URL (combined host:port)
# Set this OR use individual REDIS_HOST/PORT below
REDIS_URL=redis://localhost:6379

# Redis host (alternative to REDIS_URL)
REDIS_HOST=localhost

# Redis port (default 6379)
REDIS_PORT=6379

# Redis password (if authentication enabled)
# Leave empty if no authentication
REDIS_PASSWORD=

# ============================================================
# EMAIL (SMTP) — CRITICAL FOR DEMAND LETTERS & RECEIPTS
# ============================================================
# IMPORTANT: Email is REQUIRED for production!
# Demand letters, receipts, and notifications are sent via email.
# If email is not configured, notifications will be queued
# but never sent.
#
# For production, options:
#   1. Google Workspace / Gmail with App Password
#   2. SendGrid (API-based, highly reliable)
#   3. AWS SES (Simple Email Service)
#   4. Microsoft Exchange / Office 365
#
# Configuration steps:
#   Gmail: Enable 2FA → Create App Password → Use here
#   SendGrid: Create account → Generate API key → Configure SMTP relay
#   AWS SES: Verify domain → Create SMTP credentials in SES console

# SMTP server hostname
# Gmail: smtp.gmail.com
# SendGrid: smtp.sendgrid.net
# AWS SES: email-smtp.REGION.amazonaws.com
SMTP_HOST=smtp.gmail.com

# SMTP server port
# 587 for STARTTLS (recommended)
# 465 for implicit TLS
# 25 for unencrypted (NOT recommended for production)
SMTP_PORT=587

# SMTP username / email address
# Gmail: your-email@gmail.com
# SendGrid: apikey (literal)
# AWS SES: USERNAME_SMTP_CREDENTIALS
SMTP_USER=your-email@rof.co.in

# SMTP password / API token
# Gmail: Generated App Password (16 chars, spaces removed)
# SendGrid: API key from dashboard
# AWS SES: Generated SMTP password
SMTP_PASS=YOUR_APP_PASSWORD_OR_API_KEY

# Sender email address (appears as 'From' in emails)
# Should be from a verified domain
# Format: Name <email@domain.com> or email@domain.com
SMTP_FROM=ROF Group <noreply@rof.co.in>

# TLS security mode
# true = require TLS (port 465)
# false = use STARTTLS (port 587, recommended)
SMTP_SECURE=false

# ============================================================
# SMS (Twilio) — OPTIONAL FOR TRANSACTIONS
# ============================================================
# Transactional SMS for payment reminders, notifications
# IMPORTANT: DLT (Distributed Ledger Technology) registration
# required for Indian phone numbers under TRAI regulations
#
# Steps to enable:
#   1. Create Twilio account (twilio.com)
#   2. Verify phone number and get SID/Token
#   3. Register content templates with DLT provider
#   4. Configure below
#
# For development, SMS_PROVIDER can be 'stub' (no actual SMS sent)
# For production, must be 'twilio' or another real provider

# SMS provider
# Options: stub (development), twilio (production)
# Development default: stub (messages logged but not sent)
SMS_PROVIDER=stub

# Twilio Account SID (from Twilio console)
# Leave empty if not using Twilio
TWILIO_ACCOUNT_SID=

# Twilio Auth Token (from Twilio console)
# Keep this secret - treat like a password
TWILIO_AUTH_TOKEN=

# Twilio phone number for sending SMS
# Format: +91XXXXXXXXXX (include country code)
# Must be verified in Twilio console
TWILIO_PHONE_NUMBER=

# ============================================================
# WhatsApp Business (Meta Official API)
# ============================================================
# WhatsApp integration for sending notifications, reminders
# Uses Meta's official Business API (not WhatsApp Web)
#
# Setup steps:
#   1. Create Meta Business Account (business.facebook.com)
#   2. Set up WhatsApp Business API access
#   3. Verify business phone number
#   4. Get API credentials below
#   5. Create message templates in WhatsApp Business Manager
#
# For development, leave as stub
# For production, requires Meta account and phone verification

# WhatsApp Business Account ID
# From: Meta Business Settings → WhatsApp Business API
WHATSAPP_BUSINESS_ACCOUNT_ID=

# WhatsApp Phone Number ID
# The unique ID of your verified phone number
# From: WhatsApp Business Manager → Phone Numbers
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp API Bearer Token
# Access token for API authentication
# From: Meta for Business → WhatsApp → Manage API
# Regenerate periodically for security
WHATSAPP_API_TOKEN=

# ============================================================
# FILE STORAGE
# ============================================================
# Directory for storing uploaded files
# (documents, floor plans, consumer photos)
#
# For development: Local filesystem fine
# For production options:
#   - Local: ./uploads (requires persistent volume)
#   - AWS S3: Configure via code (recommended for cloud)
#   - Google Cloud Storage: Configure via code
#   - Azure Blob Storage: Configure via code
#
# IMPORTANT: Ensure adequate disk space
# Expected: 100+ MB for typical deployment

# Local file storage path
# Directory is created automatically if it doesn't exist
FILE_STORAGE_PATH=./uploads

# Maximum file size (MB) for uploads
# Applies to documents, floor plans, consumer photos
MAX_FILE_SIZE_MB=10

# ============================================================
# PDF GENERATION (Puppeteer/Chrome)
# ============================================================
# Used for generating allotment letters, demand letters,
# payment receipts, agreements

# Headless mode (run without display)
# true = headless (recommended for servers)
# false = display UI (only for desktop testing)
PUPPETEER_HEADLESS=true

# ============================================================
# AI FEATURES (Anthropic Claude API)
# ============================================================
# Claude API for AI-assisted reply suggestions
# Users can ask Claude for help drafting responses
#
# Setup:
#   1. Create Anthropic account (console.anthropic.com)
#   2. Generate API key from dashboard
#   3. Add key below
#   4. Feature automatically available in communications module
#
# For development: Stub key fine (feature disabled)
# For production: Real key required

# Anthropic API key for Claude
# Get from: console.anthropic.com → API Keys
# Format: sk-ant-v0-... (long string)
# Treat like a password - keep it secret
ANTHROPIC_API_KEY=sk-ant-CHANGE_THIS_TO_YOUR_REAL_KEY

# ============================================================
# LOGGING & DEBUGGING
# ============================================================
# Application log level
# Options (in increasing verbosity):
#   error   - Only errors (recommended for production)
#   warn    - Warnings and errors
#   info    - General info, warnings, errors (recommended for staging)
#   debug   - Detailed debugging output (development only)
#   trace   - Very detailed (development only)
#
# Production recommendation: error or warn
# Development recommendation: info or debug
LOG_LEVEL=info

# ============================================================
# DEPLOYMENT CHECKLIST FOR PRODUCTION
# ============================================================
# Before deploying to production, verify:
#
# [ ] NODE_ENV = 'production'
# [ ] DATABASE: Real PostgreSQL (AWS RDS or self-hosted)
# [ ] JWT_SECRET: Changed to strong random secret
# [ ] HASH_SECRET: Changed to strong random secret
# [ ] REDIS: Configured (AWS ElastiCache or self-hosted)
# [ ] SMTP: Configured with real email provider
# [ ] CORS_ORIGINS: Updated with production domain(s)
# [ ] All passwords use strong random values
# [ ] .env is in .gitignore and not committed
# [ ] .env.example has placeholder values only
# [ ] Database backups configured
# [ ] File storage has persistent volume
# [ ] Logs are being collected and monitored
# [ ] SSL certificate configured on reverse proxy
#
# Post-deployment verification:
# [ ] Dashboard KPIs loading correctly
# [ ] Consumers can be created and retrieved
# [ ] Units show correct inventory status
# [ ] Demand letter generation working
# [ ] Email delivery confirmed
# [ ] SMS delivery confirmed (if enabled)
# [ ] Audit logs recording changes
# [ ] File uploads persisting
# [ ] API responding to requests
#
# ============================================================
# SUPPORT & TROUBLESHOOTING
# ============================================================
# Common issues:
#
# "Cannot connect to database"
#   → Verify DB_HOST, DB_PORT, DB_USER, DB_PASSWORD
#   → Check firewall rules allow connection
#   → Run: psql -h DB_HOST -U DB_USER -d DB_NAME
#
# "Redis connection refused"
#   → Verify Redis is running on REDIS_HOST:REDIS_PORT
#   → Check firewall rules
#   → Run: redis-cli -h REDIS_HOST ping
#
# "Email not sending"
#   → Verify SMTP credentials are correct
#   → Check firewall allows port SMTP_PORT
#   → Test: telnet SMTP_HOST SMTP_PORT
#   → Verify app password (Gmail) or API key (SendGrid)
#
# "JWT verification failed"
#   → JWT_SECRET may have changed
#   → Users will need to log in again
#   → Check all servers have same JWT_SECRET
#
# For detailed logs:
#   → Set LOG_LEVEL=debug
#   → Check server logs: docker logs or pm2 logs
#
# ============================================================

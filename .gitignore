# Dependencies
node_modules/
pnpm-lock.yaml
yarn.lock
package-lock.json

# Build output
# packages/api/dist is committed for local runs (node dist/index.js). Vercel rebuilds it on every
# deploy (tsc && node copy-files.js, see vercel.json), so keep it in sync before commits; CI checks this.
packages/web/dist/
packages/design-system/dist/
build/
.storybook-static/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local
.env.*.local

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Temporary files
.cache/
.tmp/
*.tmp

# Testing
coverage/

# Database
*.db
*.sqlite
*.sqlite3
db_export.sql
backup_*.sql

# Uploaded files: ignore contents, keep the folders (multer does not create them)
packages/api/uploads/*/*
!packages/api/uploads/*/.gitkeep
.vercel
.env*

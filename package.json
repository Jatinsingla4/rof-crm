{
  "name": "rof-crm",
  "version": "1.0.0",
  "description": "ROF Group CRM - Haryana Affordable Housing Management Platform",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "start": "node packages/api/dist/index.js",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "type-check": "pnpm -r type-check",
    "test": "pnpm -r test",
    "clean": "pnpm -r exec rm -rf dist node_modules .storybook-static",
    "storybook:build": "cd packages/design-system && pnpm build-storybook",
    "storybook:dev": "cd packages/design-system && pnpm storybook"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "typescript": "^5.3.3"
  },
  "keywords": [
    "crm",
    "real-estate",
    "affordable-housing",
    "haryana",
    "rera"
  ],
  "author": "Grapes Worldwide",
  "license": "PROPRIETARY",
  "dependencies": {
    "express": "^4.22.1",
    "framer-motion": "^10.18.0",
    "http-proxy-middleware": "^3.0.5"
  }
}
